{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/company-recommendations-output.schema.json",
  "title": "Grounded company recommendations output",
  "type": "object",
  "additionalProperties": false,
  "required": ["recommendations", "excludedCompanies"],
  "properties": {
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "companyId",
          "slot",
          "recommendedRole",
          "rationale",
          "connectedExperienceIds",
          "matchingConditions",
          "concerns",
          "unknowns",
          "verificationQuestions",
          "companySourceIds"
        ],
        "properties": {
          "companyId": { "type": "string", "format": "uuid" },
          "slot": {
            "type": "string",
            "enum": ["PRIMARY", "CHALLENGE", "UNEXPECTED"]
          },
          "recommendedRole": {
            "type": ["string", "null"],
            "maxLength": 300
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 3000 },
          "connectedExperienceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "matchingConditions": {
            "type": "array",
            "items": { "type": "string", "maxLength": 1000 }
          },
          "concerns": {
            "type": "array",
            "items": { "type": "string", "maxLength": 1000 }
          },
          "unknowns": {
            "type": "array",
            "items": { "type": "string", "maxLength": 1000 }
          },
          "verificationQuestions": {
            "type": "array",
            "items": { "type": "string", "maxLength": 1000 }
          },
          "companySourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    "excludedCompanies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["companyId", "reason"],
        "properties": {
          "companyId": { "type": "string", "format": "uuid" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}

