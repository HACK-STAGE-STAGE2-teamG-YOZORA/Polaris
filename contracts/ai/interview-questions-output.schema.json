{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/interview-questions-output.schema.json",
  "title": "Grounded interview questions output",
  "type": "object",
  "additionalProperties": false,
  "required": ["deepDiveQuestions", "reverseQuestions"],
  "properties": {
    "deepDiveQuestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "purpose", "connectedExperienceIds"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "connectedExperienceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          }
        }
      }
    },
    "reverseQuestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "purpose", "companySourceIds"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "companySourceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  }
}
