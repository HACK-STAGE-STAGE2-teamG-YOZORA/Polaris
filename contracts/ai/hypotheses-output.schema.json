{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/hypotheses-output.schema.json",
  "title": "Four-axis self-analysis generation output",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessments", "missingAxes", "contradictionsToExplore"],
  "properties": {
    "assessments": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "suggestedPosition",
          "statement",
          "leftEvidenceIds",
          "rightEvidenceIds",
          "bothEvidenceIds",
          "contextEvidenceIds",
          "counterEvidenceIds",
          "leftConditions",
          "rightConditions",
          "contextNotes"
        ],
        "properties": {
          "axis": { "$ref": "common.schema.json#/$defs/selfAnalysisAxis" },
          "suggestedPosition": { "$ref": "common.schema.json#/$defs/axisPosition" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "leftEvidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "rightEvidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "bothEvidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "contextEvidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "counterEvidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "leftConditions": {
            "type": "array",
            "items": { "type": "string", "maxLength": 500 }
          },
          "rightConditions": {
            "type": "array",
            "items": { "type": "string", "maxLength": 500 }
          },
          "contextNotes": {
            "type": "array",
            "items": { "type": "string", "maxLength": 700 }
          }
        }
      }
    },
    "missingAxes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/selfAnalysisAxis" }
    },
    "contradictionsToExplore": {
      "type": "array",
      "items": { "type": "string", "maxLength": 1000 }
    }
  }
}
