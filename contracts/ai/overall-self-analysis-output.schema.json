{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/overall-self-analysis-output.schema.json",
  "title": "Overall self-analysis profile language output",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "axisTrends", "strengths", "weaknesses"],
  "$defs": {
    "profileInsight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "axes",
        "sourceReportIds",
        "evidenceIds"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/selfAnalysisAxis" }
        },
        "sourceReportIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    }
  },
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "axisTrends": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "suggestedPosition",
          "statement",
          "sourceReportIds",
          "evidenceIds",
          "contextNotes"
        ],
        "properties": {
          "axis": { "$ref": "common.schema.json#/$defs/selfAnalysisAxis" },
          "suggestedPosition": { "$ref": "common.schema.json#/$defs/axisPosition" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1500 },
          "sourceReportIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "format": "uuid" }
          },
          "contextNotes": {
            "type": "array",
            "items": { "type": "string", "maxLength": 700 }
          }
        }
      }
    },
    "strengths": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/profileInsight" }
    },
    "weaknesses": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/profileInsight" }
    }
  }
}
