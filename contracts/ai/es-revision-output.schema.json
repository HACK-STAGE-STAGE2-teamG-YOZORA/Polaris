{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/es-revision-output.schema.json",
  "title": "ES revision output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revisedText",
    "usedExperienceIds",
    "usedSessionReportIds",
    "changes",
    "questionsForUser"
  ],
  "properties": {
    "revisedText": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "usedExperienceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "usedSessionReportIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "format": "uuid" }
    },
    "changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after", "reason", "evidence"],
        "properties": {
          "before": { "type": "string", "maxLength": 5000 },
          "after": { "type": "string", "maxLength": 5000 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/sourceEvidence" }
          }
        }
      }
    },
    "questionsForUser": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  }
}
