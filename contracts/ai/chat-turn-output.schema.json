{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/chat-turn-output.schema.json",
  "title": "Self-analysis chat turn output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply",
    "evidenceCandidates",
    "missingAxes",
    "nextQuestionTarget",
    "experienceReady",
    "completionIntent"
  ],
  "properties": {
    "reply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "ユーザーへ表示する返答。一度に質問は一つだけ。"
    },
    "evidenceCandidates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "axis",
          "pole",
          "statement",
          "supportType",
          "messageId",
          "quote",
          "interpretation"
        ],
        "properties": {
          "axis": { "$ref": "common.schema.json#/$defs/selfAnalysisAxis" },
          "pole": { "$ref": "common.schema.json#/$defs/axisPole" },
          "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "supportType": { "$ref": "common.schema.json#/$defs/evidenceSupportType" },
          "messageId": { "type": "string", "format": "uuid" },
          "quote": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "interpretation": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "missingAxes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/selfAnalysisAxis" }
    },
    "nextQuestionTarget": {
      "type": "string",
      "enum": [
        "ENERGY_SOURCE",
        "ACTION_STYLE",
        "SATISFACTION_SOURCE",
        "PREFERRED_ENVIRONMENT",
        "EXPERIENCE_DETAIL",
        "CONTRADICTION",
        "CONFIRMATION"
      ]
    },
    "experienceReady": { "type": "boolean" },
    "completionIntent": {
      "type": "string",
      "enum": ["NONE", "SUGGESTED"],
      "description": "終了候補の検出結果。SUGGESTEDでも自動終了せず本人確認を必要とする。"
    }
  }
}
