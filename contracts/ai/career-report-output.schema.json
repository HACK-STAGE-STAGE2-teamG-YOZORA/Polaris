{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/career-report-output.schema.json",
  "title": "Self-analysis report language output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "axisComments",
    "mustConditions",
    "preferConditions",
    "avoidConditions",
    "verifyConditions",
    "nextExperiments"
  ],
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "axisAssessmentIds"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "axisAssessmentIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    }
  },
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "axisComments": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "axisAssessmentId", "comment"],
        "properties": {
          "axis": { "$ref": "common.schema.json#/$defs/selfAnalysisAxis" },
          "axisAssessmentId": { "type": "string", "format": "uuid" },
          "comment": { "type": "string", "minLength": 1, "maxLength": 1500 }
        }
      }
    },
    "mustConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "preferConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "avoidConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "verifyConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "nextExperiments": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  }
}
