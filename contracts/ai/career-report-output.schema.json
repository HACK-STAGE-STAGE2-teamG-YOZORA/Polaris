{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/ai/career-report-output.schema.json",
  "title": "Career report language output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "energizingActivities",
    "drainingActivities",
    "enablingContexts",
    "riskContexts",
    "mustConditions",
    "preferConditions",
    "avoidConditions",
    "verifyConditions",
    "nextExperiments"
  ],
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "hypothesisIds"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "hypothesisIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        }
      }
    }
  },
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 3000 },
    "energizingActivities": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "drainingActivities": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "enablingContexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "riskContexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "mustConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "preferConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "avoidConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "verifyConditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "nextExperiments": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  }
}

