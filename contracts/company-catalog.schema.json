{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polaris.local/schemas/company-catalog.schema.json",
  "title": "Polaris curated company catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "companies"],
  "properties": {
    "catalogVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "companies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "officialUrl",
          "careerUrl",
          "targetRoles",
          "locations",
          "recommendationEligible"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "officialUrl": { "type": "string", "format": "uri" },
          "careerUrl": { "type": ["string", "null"], "format": "uri" },
          "targetRoles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 200 }
          },
          "locations": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 200 }
          },
          "recommendationEligible": { "const": true },
          "note": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}

