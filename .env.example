# Web
APP_URL=http://localhost:3000
DATABASE_URL=file:./data/polaris.db
LOG_LEVEL=info

# LM Studio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
LM_STUDIO_MODEL_ID=qwen/qwen3.5-9b
LM_API_TOKEN=
LM_STUDIO_CONTEXT_LENGTH=16384
LM_STUDIO_GPU_OFFLOAD=max
LM_STUDIO_FLASH_ATTENTION=true
AI_CHAT_TIMEOUT_MS=60000
AI_TASK_TIMEOUT_MS=120000
AI_JSON_REPAIR_MAX_ATTEMPTS=1
AI_CHAT_TEMPERATURE=0.6
AI_STRUCTURED_TEMPERATURE=0.1
AI_MAX_OUTPUT_TOKENS=4096
AI_ENABLE_THINKING=false

# Company source import
COMPANY_URL_IMPORT_ENABLED=true
COMPANY_FILE_IMPORT_ENABLED=false
COMPANY_FETCH_CONNECT_TIMEOUT_MS=10000
COMPANY_FETCH_TOTAL_TIMEOUT_MS=30000
COMPANY_FETCH_MAX_BYTES=2097152
COMPANY_FETCH_MAX_REDIRECTS=3
COMPANY_UPLOAD_MAX_BYTES=10485760
COMPANY_SOURCE_CACHE_TTL_HOURS=24

# Grounded company recommendations (registered catalog only)
COMPANY_RECOMMENDATION_ENABLED=true
COMPANY_RECOMMENDATION_MAX_CANDIDATES=10
